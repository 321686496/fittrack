+        _day(1, '胸部日', [_ex('ex_001', '杠铃卧推', 4, 10)]),
+      ]);
+      final result = service.recommendForSystemPlan(
+        plan,
+        records: [
+          {
+            'planId': 'user_old_1',
+            'setRecords': {
+              'ex_001': [
+                {'set': 1, 'weight': 60, 'reps': 10},
+              ],
+            },
+          },
+        ],
+        bodyData: {'height': 175, 'weight': 65},
+        settings: {'fitnessLevel': '新手'},
+        userPlans: [oldPlan],
