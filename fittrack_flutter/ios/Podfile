# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

# RestLiveActivity 为纯 SwiftUI/WidgetKit/ActivityKit 扩展，不使用任何 Flutter 插件，
# 因此**不**在 Podfile 中声明为目标。如果把它作为 pod 目标，CocoaPods 会：
#  1. 给它生成 Pods-RestLiveActivity 配置；
#  2. 并且 RestLiveActivity 若共享 Runner 的 Debug/Release.xcconfig，会继承 pod install
#     追加进这些 xcconfig 的 "Pods-Runner" 配置，从而被强制链接所有插件框架
#     （mobile_scanner/permission_handler_apple/MLKit）与 Flutter.framework。
# 但扩展不 import Flutter，导致 "Undefined symbols ... _FlutterMethodNotImplemented" 链接失败。
# 正确做法：不在 Podfile 声明该 target，并让 pbxproj 中其 baseConfigurationReference
# 指向 Flutter/Generated.xcconfig（只含 FLUTTER_BUILD_NAME/NUMBER，无任何 pod 链接标志）。

require 'fileutils'

# ---------------------------------------------------------------------------
# ITMS-91061 fix: 让每个第三方 SDK 的 framework 在**编译时**就带上
# PrivacyInfo.xcprivacy（而非归档末尾事后注入）。
#
# 原理：App Store 会逐一检查嵌入 app 的第三方 framework 是否含隐私清单。
# 之前的实现（在 Runner 的归档 build phase 里往产物 framework 拷贝 manifest）
# 经实测：最终 ipa 中这些 framework 里根本没有 PrivacyInfo.xcprivacy。
# 因此改为在 CocoaPods post_install 阶段，把清单作为资源加入每个 pod target：
#   - 用**绝对路径**引用清单文件，彻底避免相对路径解析失败；
#   - framework 构建时资源就会被拷贝进去并随框架一起签名嵌入。
# ---------------------------------------------------------------------------
PRIVACY_MANIFEST_SRC = File.expand_path('PrivacyManifests/PrivacyInfo.xcprivacy', __dir__)
# 需要补隐私清单的第三方 SDK framework（App Store ITMS-91061 报错清单）
PRIVACY_PODS = %w[GTMSessionFetcher GoogleToolboxForMac image_picker_ios share_plus sqflite url_launcher_ios].freeze

post_install do |installer|
  # --- ITMS-91061: 给指定 pod 注入 PrivacyInfo.xcprivacy 资源 ---
  installer.pods_project.targets.each do |target|
    next unless PRIVACY_PODS.include?(target.name)
    next if target.resources_build_phase.files_references.any? do |f|
      f.display_name == 'PrivacyInfo.xcprivacy' ||
        (f.real_path.to_s.include?('PrivacyInfo.xcprivacy') rescue false)
    end

    dest = File.join(installer.sandbox.root, target.name, 'PrivacyInfo.xcprivacy')
    FileUtils.mkdir_p(File.dirname(dest))
    FileUtils.copy(PRIVACY_MANIFEST_SRC, dest) unless File.exist?(dest)

    # 用绝对路径引用，保证 Pods 工程能正确定位到该文件
    ref = installer.pods_project.new_file(dest)
    ref.source_tree = '<absolute>'
    ref.path = dest
    # 缓存到组，避免给同一 manifest 建多个引用
    target.resources_build_phase.add_file_reference(ref)
  end

  # --- GC: 移除 Pods 工程里旧的、错误的 PrivacyInfo 引用（若有） ---
  installer.pods_project.targets.each do |target|
    next unless PRIVACY_PODS.include?(target.name)
    target.resources_build_phase.files_references.each do |f|
      next unless f.path.to_s.end_with?('PrivacyInfo.xcprivacy') && !File.exist?(f.real_path.to_s)
      target.resources_build_phase.remove_file_reference(f)
    end
  end

  # --- 其它 Pod 构建设置 ---
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # permission_handler_apple 要求通过 GCC_PREPROCESSOR_DEFINITIONS 启用对应权限的编译开关。
      # 未启用的权限策略类会编译为空壳，checkPermissionStatus/requestPermission 始终返回 denied，
      # 导致 iOS 永不弹出系统的权限授权弹窗（例如相机扫码提示「需要相机权限」）。
      # PERMISSION_NOTIFICATIONS=1：通知权限（NotificationPermissionStrategy）
      # PERMISSION_CAMERA=1：相机权限（AudioVideoPermissionStrategy），扫码激活/识别依赖它
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_CAMERA=1',
      ]
    end
  end
end
